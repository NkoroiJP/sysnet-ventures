# Copy to .env and fill in. Used by docker-compose.

# --- Django ---
# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
TIME_ZONE=Africa/Nairobi

# --- Database (production) ---
# Either use the bundled Postgres profile:
#   docker compose --profile postgres up -d
# with DATABASE_URL below, or point at a managed Postgres:
DATABASE_URL=
POSTGRES_PASSWORD=

# --- First-boot superuser (optional but recommended) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Gunicorn ---
GUNICORN_WORKERS=3

# --- HTTPS (enable when behind a TLS-terminating proxy) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
