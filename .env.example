# ============================================================
# Sysnet Technologies platform — environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ============================================================

# --- Django core -------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string
# True only for local development; NEVER True in production.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=Africa/Nairobi

# --- Database (Docker Compose provides Postgres) -----------
# The web container builds this automatically from POSTGRES_PASSWORD:
#   postgres://sysnet:<POSTGRES_PASSWORD>@db:5432/sysnet
# Override only when pointing at an external/managed Postgres.
# DATABASE_URL=
POSTGRES_PASSWORD=change-me-strong-password

# --- First-boot superuser (optional) ------------------------
# Created automatically on first startup if both are set.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Gunicorn ------------------------------------------------
GUNICORN_WORKERS=3

# --- Email notifications -------------------------------------
# Console backend prints emails to the container log (dev default).
# For production use SMTP and set the credentials below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Where new enquiries / quotation decisions are sent (falls back to company email).
STAFF_NOTIFY_EMAIL=

# --- Security (production only; see docker-compose.prod.yml) --
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# --- Uploads --------------------------------------------------
MAX_UPLOAD_SIZE_MB=5

# --- Rate limiting (per IP / username) ------------------------
THROTTLE_LOGIN_LIMIT=10
THROTTLE_FORM_LIMIT=10
